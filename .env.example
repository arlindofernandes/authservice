SPRING_PROFILES_ACTIVE=prod
AUTH_SERVICE_IMAGE=authservice:dev
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0

# Generate keys as documented in the README. Never commit a production private key.
JWT_PRIVATE_KEY=replace_with_a_base64_encoded_pkcs8_rsa_private_key
JWT_PUBLIC_KEY=replace_with_a_base64_encoded_x509_rsa_public_key
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=your-microservices
JWT_KEY_ID=auth-key-2026-01
JWT_EXPIRATION=900000
ADMIN_REGISTRATION_TOKEN=replace_with_a_long_random_platform_admin_token
OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=0.1

DB_NAME=authdb
DB_URL=jdbc:postgresql://db:5432/authdb
DB_USER=auth
DB_PASSWORD=auth
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000
DB_MAX_LIFETIME_MS=1800000

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=2000
HTTP_CONNECTION_TIMEOUT_MS=5000
